# https://integrate.api.nvidia.com/v1 ; $0, rate-limited. Doc: docs/reference/nvidia-build.md
NVIDIA_API_KEY=            # nvapi-* ; console key name: NVIDIABuild-Autogen-17

# Mistral La Plateforme Experiment (free) tier — OpenAI-compatible at https://api.mistral.ai/v1 ;
# $0; PER-MODEL limits 1 req/s, 500k tok/min, 1B tok/month; free tier trains on submitted data.
MISTRAL_API_KEY=
# Additional NVIDIA Build keys (spares — same endpoint, per-key rate limits)
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
# Additional Mistral keys (spares) + the HARD monthly budget across ALL Mistral keys
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
MISTRAL_API_KEY_4=
MISTRAL_API_KEY_5=
MISTRAL_API_KEY_6=
MISTRAL_API_KEY_7=
MISTRAL_API_KEY_8=
MISTRAL_MONTHLY_CAP_USD=10
# Groq Cloud (console.groq.com) free tier — OpenAI-compatible at https://api.groq.com/openai/v1 ;
# $0; ~30 req/min, 1000 req/day PER KEY. Only GROQ_API_KEY is autoloaded by libs/subagents
# (_dotenv.py DOTENV_KEYS); the _2 spare is manual-selection, same shape as the NVIDIA spares.
GROQ_API_KEY=              # gsk_*
GROQ_API_KEY_2=            # spare (same free limits, separate per-key bucket)
GROQ_API_KEY_3=            # spare
GROQ_API_KEY_4=            # spare
GROQ_API_KEY_5=            # spare
GROQ_API_KEY_6=            # spare
# Z.AI Open Platform (international Zhipu) — OpenAI-compatible at https://api.z.ai/api/paas/v4
ZAI_API_KEY=

# Factory.ai — used by Traycer CLI agents

FACTORY_API_KEY=

