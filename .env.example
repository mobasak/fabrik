# Fabrik Environment Configuration
# Copy to .env and fill in your values
# NEVER commit .env to git

# =============================================================================
# VPS Connection
# =============================================================================
VPS_HOST=<your-vps-ip>
VPS_IP=<your-vps-ip>   # Public IP used for DNS A records
VPS_USER=ozgur
# VPS_SSH_KEY=~/.ssh/id_rsa  # Optional, uses default if not set

# =============================================================================
# Coolify API — LEGACY (Coolify decommissioned 2026-05-30; deploy is SSH + Docker
# Compose via `fabrik apply`). These vars are NOT used operationally, but the
# legacy `src/fabrik/config.py` Config + `deploy.py`/`portability.py` still declare
# COOLIFY_API_URL/TOKEN as required, so they remain as placeholders until that
# legacy code is removed. Leave blank/default — nothing in normal operation reads them.
# =============================================================================
COOLIFY_API_URL=https://coolify.yourdomain.com
COOLIFY_API_TOKEN=
COOLIFY_ADMIN_EMAIL=ob@ocoron.com
COOLIFY_ADMIN_PASSWORD=   # CSPRNG 32-char, reset via: docker exec coolify php artisan tinker
# Optional: auto-detected if not set
COOLIFY_SERVER_UUID=
COOLIFY_PROJECT_UUID=
COOLIFY_ENVIRONMENT_UUID=  # Optional: auto-detected from project
COOLIFY_PRIVATE_KEY_UUID=  # Optional: Coolify SSH deploy-key UUID for git@ repos. Auto-discovered via /security/keys if unset. Required when repo is SSH and no key is is_git_related=true.

# =============================================================================
# Site Provisioner (the one live Fabrik microservice)
# =============================================================================
# site-provisioner handles domain/DNS/container provisioning. (The old standalone
# dns-manager service is retired; per-record DNS also goes via the Cloudflare driver.)
SITE_PROVISIONER_URL=https://provision.vps1.ocoron.com  # site-provisioner public URL
SITE_PROVISIONER_INTERNAL_URL=http://localhost:8001  # SSH-proxied internal URL — bypasses Traefik IP allowlist from WSL
SITE_PROVISIONER_API_KEY=                              # X-API-Key for site-provisioner (same as API_KEY on VPS)

# Direct Namecheap API (only needed if running namecheap service locally)
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=
# NAMECHEAP_CLIENT_IP=

# =============================================================================
# DNS - Cloudflare (Phase 4+, optional)
# =============================================================================
# CLOUDFLARE_API_TOKEN scope: Zone.Zone:Edit + Zone.DNS:Edit.
# Required for site-provisioner POST /api/cloudflare/zones/{domain}/provision (zone create).
# Narrowing to Zone:Read breaks new-domain onboarding.
# See docs/development/plans/fabrik workflow missing items/02-tier1-foundation.md §8.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# =============================================================================
# Backblaze B2 (Backups)
# =============================================================================
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=fabrik-backups

# =============================================================================
# Database (shared PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://fabrik:password@postgres-main:5432/fabrik

# =============================================================================
# Docker Hub
# =============================================================================
DOCKER_HUB_USERNAME=
DOCKER_HUB_ACCESS_TOKEN=

# =============================================================================
# Supabase (Cloud Database + Auth)
# =============================================================================
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=  # Anonymous/public key
SUPABASE_SERVICE_ROLE_KEY=  # Service role key (server-side only)

# =============================================================================
# Cloudflare R2 (Object Storage)
# =============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fabrik-files
R2_PUBLIC_URL=  # Optional: public URL for bucket

# =============================================================================
# AI Services

# ==============================================================================
# Content Creation Pipeline (SEO → TCO → Image Broker)
# ==============================================================================
# SEO keyword research and brief generation service
SEO_API_URL=http://localhost:8016
SEO_API_KEY=

# Triggered Content Orchestration (TCO) — AI content generation
TCO_API_URL=http://localhost:8025
TCO_API_KEY=

# Image Broker — RETIRED 2026-06-02 (service removed; stock images sourced directly
# from Unsplash/Pexels/Pixabay APIs). Var kept only for any legacy content-pipeline ref.
IMAGE_BROKER_URL=http://localhost:18016

# Content worker ID for brief lifecycle tracking
CONTENT_WORKER_ID=fabrik-content-publisher

# WordPress credentials (v1 single-site — switch env vars per domain)
WP_SITE_URL=               # WordPress site URL (e.g. https://example.com)
WP_USERNAME=               # WordPress application username
WP_PASSWORD=               # WordPress application password (generate at /wp-admin/profile.php)
# =============================================================================

# AI/LLM — no direct Anthropic/OpenAI API keys are used. Operational AI (sysadmin
# bot, watchdog, aro-wake, bootstrap) runs on Claude Code subscription OAuth, and
# content/LLM calls go through OpenRouter (the watchdog uses WATCHDOG_OPENROUTER_KEY,
# set in its own deploy env — not here). The old `fabrik ai generate/revise` direct-API
# client was removed 2026-06-16.

# Factory.ai — used by Traycer CLI agents

FACTORY_API_KEY=

# =============================================================================
# Infrastructure Services (Phase 9)
# =============================================================================
# MinIO S3-compatible storage — RETIRED / not deployed (object storage via Backblaze
# B2 + Cloudflare R2 directly). Vars kept for any legacy reference.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=   # Generate: python3 -c "import secrets; print(f'MINIO_ROOT_PASSWORD={secrets.token_urlsafe(32)}')"; paste output to local .env (not committed)

# Meilisearch fast search engine
MEILI_MASTER_KEY=      # Generate: python3 -c "import secrets; print(f'MEILI_MASTER_KEY={secrets.token_urlsafe(32)}')"; paste output to local .env (not committed)


# Optional: Droid exec configuration
# DROID_DATA_DIR=/opt/fabrik/.droid
# DROID_EXEC_TIMEOUT=1800

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Individual connection parameters (alternative to DATABASE_URL)
DB_HOST=postgres-main
DB_PORT=5432
DB_NAME=fabrik
DB_USER=postgres
DB_PASSWORD=

# =============================================================================
# Monitoring
# =============================================================================
GRAFANA_ADMIN_PASSWORD=   # Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"; paste to local .env (not committed)
# GlitchTip error tracking (errors.vps1.ocoron.com) — declared in specs/infrastructure/glitchtip.yaml.
# Use the EXISTING live values from /opt/glitchtip/compose.yaml; regenerating breaks the live tracker.
GLITCHTIP_SECRET_KEY=     # Django SECRET_KEY (existing live value — do NOT regenerate)
GLITCHTIP_REDIS_URL=      # e.g. redis://redis-main:6379/<db> (existing live value)
LOKI_URL=http://loki:3100  # Internal Loki endpoint for fabrik logs CLI command
# Uptime Kuma RETIRED — status monitoring is Gatus (status.vps1.ocoron.com), which
# is config-file driven (no auth/API). The vars below are dead.
UPTIME_KUMA_URL=https://status.vps1.ocoron.com
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=

# =============================================================================
# n8n Automation (Phase 8)
# =============================================================================
N8N_ENCRYPTION_KEY=   # Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"; paste to local .env (not committed)
N8N_API_KEY=               # Generate in n8n Settings → API after first login
N8N_WEBHOOK_DEPLOY=          # n8n webhook URL for deploy events
N8N_WEBHOOK_CONTENT=         # n8n webhook URL for content publish events
N8N_WEBHOOK_TIMEOUT=5        # seconds to wait for webhook response
APPRISE_STATELESS_URLS=      # Apprise notification URLs e.g. tgram://bottoken/chatid

# Netdata REMOVED 2026-05-30 — host/container metrics now via node-exporter +
# cAdvisor → Prometheus → Grafana (no netdata.vps1.ocoron.com).

# =============================================================================
# External APIs
# =============================================================================
# Translation (DeepL — external API, current)
DEEPL_API_KEY=
# TRANSLATOR_URL — RETIRED internal translator microservice (NXDOMAIN); use DeepL directly.
TRANSLATOR_URL=https://translator.vps1.ocoron.com

# Email (Resend — external API, current)
RESEND_API_KEY=
# EMAIL_GATEWAY_URL — RETIRED internal email-gateway microservice (NXDOMAIN); use Resend directly.
EMAIL_GATEWAY_URL=https://email.vps1.ocoron.com

# Captcha (Anti-Captcha — external API, current)
ANTICAPTCHA_API_KEY=
# CAPTCHA_URL — RETIRED internal captcha microservice (NXDOMAIN); use the Anti-Captcha API directly.
CAPTCHA_URL=https://captcha.vps1.ocoron.com

# Proxy (Webshare — external API, current)
WEBSHARE_API_KEY=
# PROXY_URL — RETIRED internal proxy microservice (NXDOMAIN); use Webshare directly.
PROXY_URL=https://proxy.vps1.ocoron.com

# =============================================================================
# WordPress
# =============================================================================
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=

# Driver execution mode for fabrik.drivers.wordpress
# ssh   — wrap docker exec calls through `ssh ${VPS_HOST}` (default; correct for WSL dev)
# local — call sudo docker exec directly (correct when fabrik CLI runs ON the VPS, e.g. T1.5 cron, Phase 5 watchdog)
# Unknown values raise ValueError at import time. Fail-fast by design.
FABRIK_EXEC_MODE=ssh

# Container Resolver overrides. Set WP_CONTAINER_NAME_<SITE_SLUG> to manually
# define a container name, bypassing SSH auto-discovery.
# Example: WP_CONTAINER_NAME_OCORON_COM=ocoron-com-wordpress-1

# =============================================================================
# Fabrik Internal (Development/Testing)
# =============================================================================

# Kilo Code Review Configuration
# -----------------------------------------------------------------------------
# Tiered Model Selection (Cost-Aware Escalation)
# Strategy options: free, economy, standard, premium, critical
# - free: Start with free models (deepseek), escalate to Economy → Balanced
# - economy: Start with cheap models (gemini-flash), escalate to Balanced → Strong
# - standard: Start with Balanced tier (gpt-5.2-codex), escalate to Strong → Prime
# - premium: Start with Strong tier (claude-sonnet), escalate to Prime
# - critical: Start with Prime tier (claude-opus) - no escalation
KILO_DEFAULT_STRATEGY=  # Auto-detected from risk level if not set

# Maximum cost per review in $/M tokens (stops escalation at budget cap)
# Example: 1.00 = stop at $1/M tokens (won't use Strong/Prime tiers)
KILO_MAX_COST=  # No limit if not set

# Verify PASS verdicts on high-risk code with stronger model (default: true)
# Set to false to disable false negative detection (saves tokens but less safe)
KILO_VERIFY_HIGH_RISK=true

# Audit sampling rate for PASS verdicts (default: 0.05 = 5%)
# Logs sampled reviews to .droid/review_audits.jsonl for quality monitoring
KILO_AUDIT_SAMPLE_RATE=0.05

# Retry configuration
KILO_MAX_RETRIES=3  # Max retry attempts for transient Kilo CLI failures (exponential backoff, min 1)
# FABRIK_ROOT=/opt/fabrik
# FABRIK_REVIEW_QUEUE=${FABRIK_ROOT}/.droid/review_queue
# FABRIK_REVIEW_RESULTS=${FABRIK_ROOT}/.droid/review_results
# FABRIK_DOCS_QUEUE=${FABRIK_ROOT}/.droid/docs_queue
# FABRIK_DOCS_LOG=${FABRIK_ROOT}/.droid/docs_log
# FABRIK_MODELS_CONFIG=${FABRIK_ROOT}/config/models.yaml
# FABRIK_NOTIFY_SCRIPT=~/.factory/hooks/notify.sh
# FABRIK_LOCK_DIR=/tmp/fabrik-locks   # T2-01 G-F2/F3: dir for file_lock() lock files

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# MeiliSearch
# =============================================================================
# Full-text search service (deployed at https://search.vps1.ocoron.com)
MEILI_MASTER_KEY=your_master_key_here
MEILI_ENV=production
MEILISEARCH_URL=https://search.vps1.ocoron.com

# =============================================================================
# Coolify
# =============================================================================
# Deployment control plane (https://coolify.vps1.ocoron.com)
COOLIFY_API_TOKEN=your_coolify_api_token_here
COOLIFY_URL=https://coolify.vps1.ocoron.com
COOLIFY_ADMIN_EMAIL=admin@ocoron.com
COOLIFY_ADMIN_PASSWORD=your_coolify_admin_password_here

# =============================================================================
# Gotenberg
# =============================================================================
# HTML/Office/PDF conversion API (deployed at https://pdf.vps1.ocoron.com)
GOTENBERG_URL=https://pdf.vps1.ocoron.com
GOTENBERG_API_ENDPOINT=/forms/chromium/convert/html

# =============================================================================
# Browserless
# =============================================================================
# Browserless v2 (open-source chromium image: ghcr.io/browserless/chromium).
# Why: headless browser pool used by web scrapers (Playwright/Puppeteer-compatible).
# How to get: VPS-deployed at https://browser.vps1.ocoron.com (SSH + Docker Compose). Generate TOKEN with `python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"` and set it in the service's `.env` on the VPS.
# Default: BROWSERLESS_TOKEN must be passed as ?token=<TOKEN> on every WS/REST call (v2 enforces auth).
BROWSERLESS_URL=https://browser.vps1.ocoron.com
BROWSERLESS_WS_URL=wss://browser.vps1.ocoron.com
BROWSERLESS_TOKEN=

# =============================================================================
# Authelia SSO (deployed at https://auth.vps1.ocoron.com)
# =============================================================================
AUTHELIA_JWT_SECRET=your_jwt_secret_here
AUTHELIA_SESSION_SECRET=your_session_secret_here
AUTHELIA_STORAGE_ENCRYPTION_KEY=your_storage_encryption_key_here
AUTHELIA_ADMIN_PASSWORD=your_admin_password_here

# =============================================================================
# Service-to-Service Auth (35-security-auth.md)
# =============================================================================
# Shared secret for X-Internal-Token header validation between Docker services
SERVICE_INTERNAL_SECRET_KEY=your_internal_secret_key_here

# =============================================================================
# Gotenberg Basic Auth
# =============================================================================
GOTENBERG_API_BASIC_AUTH_USERNAME=gotenberg
GOTENBERG_API_BASIC_AUTH_PASSWORD=your_gotenberg_password_here

# =============================================================================
# AI MODEL AGGREGATOR KEYS
# Used by scripts/kilo-benchmarks/fetch_*_prices.py to pull live per-model
# pricing into agents.gateway_prices, so the AI Models Browser surfaces the
# cheapest gateway per row. See docs/development/plans/2026-06-29-plan-2-aggregator-pricing.md
# =============================================================================

# fal.ai key (format: KEY_ID:SECRET joined by colon). Get from https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_id:your_fal_secret
