ELEVENLABS_API_KEY=sk_your_elevenlabs_key

# ─── Subagent-runs flywheel (record_agent_run → subagent_runs on postgres-main) ─────
# On the HUB (/opt/fabrik), wire peer-auth via the unix socket — the OS user
# (typically `ozgur`) matches a Postgres role that carries INSERT on subagent_runs
# and USAGE on subagent_runs_id_seq. Add via:
#   sudo -u postgres psql -d fabrik_analytics \
#     -c "GRANT INSERT ON subagent_runs, USAGE ON SEQUENCE subagent_runs_id_seq TO ozgur"
# Empty host in the DSN = local unix socket = peer-auth = no password.
# On deployed VPS projects, `fabrik apply` injects a password-auth DSN + project
# name automatically per project via `create_subagent_ins_role` — no hand wiring.
SUBAGENT_RUNS_DSN=postgresql:///fabrik_analytics
SUBAGENT_PROJECT=fabrik-hub
# Grounding canary (scripts/sysadmin/canary_grounding.py): roster size per grounding task type
CANARY_ROSTER_N=8

# Brave Search API — web-search MCP + subagents-pool web_tools
BRAVE_API_KEY=
# research-provider key — Claude Code MCP + subagents-pool web_tools
EXA_API_KEY=
# research-provider key — Claude Code MCP + subagents-pool web_tools
FIRECRAWL_API_KEY=
# research-provider key — Claude Code MCP + subagents-pool web_tools
CONTEXT7_API_KEY=
# External-services registry (Phase B) — local Postgres DSN; default is a passwordless
# peer-auth socket. Override only if the registry DB is elsewhere.
SERVICES_REGISTRY_DSN=postgresql:///fabrik_services

# ── Alert delivery (libs/alerting) ────────────────────────────────────────────
# Every alert this box raises — quota drain, keepalive, CI health, watchdog — routes
# through libs/alerting. Prove the path with: python -m alerting --selftest
# ⚠️ The Telegram credential is SPLIT here. A usable token is `<bot_id>:<secret>`;
# TELEGRAM_BOT_TOKEN historically holds only the SECRET half. Set the complete token
# in TELEGRAM_FULL_BOT_TOKEN (preferred) or supply TELEGRAM_BOT_ID to compose it —
# posting to /bot<secret>/sendMessage returns HTTP 404 and looks like a dead endpoint.
TELEGRAM_FULL_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SSH → VPS Apprise (primary leg; falls back to direct Telegram above)
ALERT_VPS_HOST=vps
ALERT_APPRISE_URL=http://apprise:8000

# fabrik-mail paths (defaults shown; override only for tests or a relocated store)
FABRIK_MAIL_ROOT=/opt/fabrik-mail
FABRIK_OPT_ROOT=/opt

# fabrik-mail loop-safety (auto-reply guards; see docs/reference/fabrik-mail.md)
FABRIK_MAIL_HOP_CAP=3
FABRIK_MAIL_RATE_CAP=5
FABRIK_MAIL_RATE_WINDOW_S=3600

# fabrik-mail escalation digest — this key is read ONLY from the cron line's env prefix
# (cron sources no .env and the alerting loader's allowlist excludes it):
# docs/workstation/fabrik-mail.md § Escalation
FABRIK_MAIL_ESCALATE_DAYS=3
