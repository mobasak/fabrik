# Windsurf/Codeium Indexing Ignore
# Optimized for Performance and WSL Stability

# --- Core Project Exclusions ---
.venv/
venv/
node_modules/
.git/
.hg/
.svn/

# --- Build Artifacts & Caches ---
build/
dist/
out/
*.egg-info/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
htmlcov/

# --- IDE & OS Metadata (Large & Constant Changes) ---
.vscode/
.idea/
.history/
.project
.settings/
.DS_Store
Thumbs.db
desktop.ini

# --- Large Binary, Data & Media Files ---
# (RAG cannot read these, but indexing them consumes massive CPU)
*.log
*.sqlite
*.db
*.pkl
*.parquet
*.onnx
*.pt
*.bin
*.exe
*.dll
*.so
*.dylib

# Media
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.pdf
*.mp4
*.mov
*.wav
*.mp3

# --- Archives ---
*.tar.gz
*.zip
*.7z
*.rar
*.gz

# --- Environment & Security ---
# .env removed to allow AI to read for deployment operations
.env.*
*.pem
*.key
*.cert

# --- Lock Files (Massive files that slow down RAG) ---
# Better to let AI read package.json or requirements.txt instead
*-lock.json
*.lock
pnpm-lock.yaml

