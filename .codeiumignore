# Exclude folders with high-frequency writes to prevent indexing loops
.droid/review_queue/
.droid/review_results/
.droid/docs_queue/
.droid/docs_log/
.droid/responses/
/tmp/fabrik-locks/
.tmp/
.staging/
*.tmp
*.bak