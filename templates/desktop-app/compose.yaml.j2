services:
  {{ spec.id }}:
    build: .
    container_name: {{ spec.id }}
    platform: linux/amd64  # MANDATORY - VPS is x86_64
    restart: unless-stopped
    
    environment:
      - NODE_ENV={{ env.get('NODE_ENV', 'production') }}
      - TZ={{ env.get('TZ', 'UTC') }}
      {% for key, value in env.items() %}
      - {{ key }}={{ value | env_escape }}
      {% endfor %}
    
    {% if spec.expose.http and not spec.expose.internal_only %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ spec.id }}.rule=Host(`{{ domain }}`)"
      - "traefik.http.routers.{{ spec.id }}.entrypoints=websecure"
      - "traefik.http.routers.{{ spec.id }}.tls.certresolver=letsencrypt"
      - "traefik.http.services.{{ spec.id }}.loadbalancer.server.port=8000"
    {% endif %}
    
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    deploy:
      resources:
        limits:
          memory: {{ resources.memory }}
          cpus: '{{ resources.cpu }}'
    
    networks:
      - coolify

networks:
  coolify:
    external: true  # Join existing Coolify mesh
