{
  "name": "desktop-app",
  "version": "1.0.0",
  "description": "Electron desktop app template",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev"
  },
  "build": {
    "appId": "com.example.desktopapp",
    "productName": "{{ spec.id }}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ]
  },
  "dependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.6.0"
  }
}
