# Auth: Pattern A (self-hosted) — the FastAPI backend (server/) is the IdP and owns
# Postgres + JWT_SECRET + REDIS_URL. The frontend holds NO DB/auth secrets; it only
# needs the backend API base URL to call /auth and /api. The backend's env (api +
# worker read this .env through compose env_file) is the block below.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database — both DSNs are injected into .env by the postgres registrar (`fabrik apply`).
# Neither has a default; a missing value fails loudly (core/35-security-auth.md).
#   DATABASE_URL        the app's runtime role (<db>_app, not the owner — D-390)
#   DATABASE_URL_OWNER  the database OWNER: server/db/schema.sql, migrations and the
#                       audit-log retention/verification jobs — nothing else
DATABASE_URL=
DATABASE_URL_OWNER=

# Auth — the IdP's AUTH_-prefixed settings (fastapi-user-auth). A successful web sign-in
# lands on the app shell, not on the marketing page at "/" (the module's default).
AUTH_WEB_LOGIN_REDIRECT=/app
# Origins allowed to sign in with cookies (the CSRF guard). Unset, the backend uses
# CORS_ORIGINS plus NEXT_PUBLIC_APP_URL; with neither, every web login is refused.
# AUTH_ALLOWED_ORIGINS=https://app.example.com

# App Config
NEXT_PUBLIC_APP_NAME=Your SaaS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Chat (POST /api/v1/chat: signed-in users only, rate-limited, Redis required) ---
# Read only by server/src/<pkg>/chat.py. Empty means chat answers 503. Never a NEXT_PUBLIC_ name.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini      # required with the key; no default
# CHAT_RATE_APP=1200/3600                  # <count>/<seconds>, the whole app
# CHAT_RATE_TENANT=600/3600                # per tenant
# CHAT_RATE_USER=60/3600                   # per signed-in user
# CHAT_RATE_IP=120/3600                    # per client IP (IPv6 per /64; IPv4-mapped, -compatible or NAT64 as its IPv4)
# CHAT_MAX_TOKENS=1024                     # max output tokens per request
# CHAT_MAX_MESSAGE_CHARS=4000
# CHAT_MAX_BODY_BYTES=65536
# CHAT_UPSTREAM_READ_TIMEOUT=60            # seconds between streamed chunks
# TEST_REDIS_URL=redis://localhost:6379/15 # server/tests/test_chat.py only; never DB 0, never REDIS_URL

# --- Background worker (python -m <pkg>.worker; every knob is optional) ---
# WORKER_MIN=1                       # claim loops kept running
# WORKER_MAX=8                       # claim loops at most, scaled on queue depth
# WORKER_SCALE_TICK_SEC=30
# WORKER_BEAT_TICK_SEC=300
# WORKER_POLL_FALLBACK_SEC=60        # safety-net poll behind LISTEN/NOTIFY
# WORKER_ORPHAN_TIMEOUT=10 minutes
# WORKER_BEAT_LOCK_KEY=910771
# WORKER_HEARTBEAT=/app/.worker-heartbeat
# WORKER_HEARTBEAT_TICK_SEC=15
# WORKER_RETRY_BASE_SEC=5            # first retry after base seconds, doubling, plus jitter
# WORKER_RETRY_MAX_SEC=3600          # backoff cap (jitter adds up to as much again)
