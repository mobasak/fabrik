# Auth: Pattern A (self-hosted) — the FastAPI backend (server/) is the IdP and owns
# Postgres + JWT_SECRET + REDIS_URL. The frontend holds NO DB/auth secrets; it only
# needs the backend API base URL to call /auth and /api. (Backend env lives in
# server/.env.example: DATABASE_URL, REDIS_URL, JWT_SECRET.)
NEXT_PUBLIC_API_URL=http://localhost:8000

# App Config
NEXT_PUBLIC_APP_NAME=Your SaaS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI chat (OpenRouter — one key, every provider: https://openrouter.ai)
# Required for /api/chat. Pick a model slug from https://openrouter.ai/models.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
