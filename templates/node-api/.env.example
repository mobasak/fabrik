# Node API Environment Variables

# Server Configuration
NODE_ENV=production
PORT=3000

# Database (if applicable) — both DSNs are injected by the postgres registrar
# (`fabrik apply`), with no default:
#   DATABASE_URL        the app's runtime role (<db>_app, not the owner — D-390)
#   DATABASE_URL_OWNER  the database OWNER: db/schema.sql and migrations only
# DATABASE_URL=
# DATABASE_URL_OWNER=

# Redis (if applicable)
# REDIS_URL=redis://localhost:6379/0

# API Keys (example)
# API_KEY=your_api_key_here
