# File Worker - Python 3.12 slim on the registry's Debian variant (amd64)
FROM python:3.12-slim-{{ versions.debian_codename }}

# Install system dependencies for processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    poppler-utils \
    tesseract-ocr \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Mandatory Healthcheck: the worker heartbeat was written in the last 120 s (never in the future).
# The same check as fabrik.scaffold.FILE_WORKER_HEARTBEAT_CHECK; exec form, so it must stay a JSON list.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import os,sys,time; p='/app/.tmp/worker_heartbeat'; sys.exit(0 if os.path.exists(p) and 0 <= time.time() - os.path.getmtime(p) < 120 else 1)"]

# Install Python dependencies with uv
COPY requirements.txt .
RUN pip install --no-cache-dir uv && \
    uv pip install --system --no-cache -r requirements.txt

# Copy app
COPY . .

# Create non-root user
RUN useradd -m -u 1001 worker && chown -R worker:worker /app
USER worker

CMD ["python", "-m", "worker.main"]
