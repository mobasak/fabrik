# File Worker - Python 3.12 Bookworm (ARM64 Optimized)
FROM python:3.12-slim-bookworm

# Install system dependencies for processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    poppler-utils \
    tesseract-ocr \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Mandatory Healthcheck: Verify worker heartbeat file is fresh
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD find /tmp/worker_heartbeat -mmin -2 || exit 1

# Install Python dependencies with uv
COPY requirements.txt .
RUN pip install --no-cache-dir uv && \
    uv pip install --system --no-cache -r requirements.txt

# Copy app
COPY . .

# Create non-root user
RUN useradd -m -u 1001 worker && chown -R worker:worker /app
USER worker

CMD ["python", "-m", "worker.main"]
