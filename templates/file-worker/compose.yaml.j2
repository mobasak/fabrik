services:
  {{ spec.id }}:
    build:
      context: .
      dockerfile: Dockerfile
    platform: linux/amd64  # Mandatory for x86_64 VPS
    container_name: {{ spec.id }}
    restart: unless-stopped

    environment:
      # Core
      - {{ 'LOG_LEVEL' | compose_env(env.get('LOG_LEVEL', 'info')) }}
      - {{ 'TZ' | compose_env(env.get('TZ', 'UTC')) }}
      # 12-Factor XI (Logs): stdout must be UNBUFFERED. Without this, Python block-buffers
      # stdout when piped to Docker's log driver — so on an OOM-kill/SIGKILL the last 4-8 KB
      # (the crash's own logs) never flush and never reach Promtail -> Loki. A worker is the
      # most likely thing to be OOM-killed, which makes this the worst place to lose them.
      {% if 'PYTHONUNBUFFERED' not in env %}
      - PYTHONUNBUFFERED=1
      {% endif %}

      # Worker config
      - {{ 'WORKER_ID' | compose_env(env.get('WORKER_ID', 'worker-1')) }}
      - {{ 'JOB_TYPES' | compose_env(env.get('JOB_TYPES', 'transcribe,ocr,extract_text')) }}
      - {{ 'POLL_INTERVAL' | compose_env(env.get('POLL_INTERVAL', '5')) }}
      - {{ 'MAX_CONCURRENT_JOBS' | compose_env(env.get('MAX_CONCURRENT_JOBS', '2')) }}
      - {{ 'MAX_PROCESSING_TIME' | compose_env(env.get('MAX_PROCESSING_TIME', '3600')) }}

      # Supabase
      - SUPABASE_URL=${SUPABASE_URL:?}
      - SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY:?}

      # R2 Storage
      - R2_ACCOUNT_ID=${R2_ACCOUNT_ID:?}
      - R2_ACCESS_KEY_ID=${R2_ACCESS_KEY_ID:?}
      - R2_SECRET_ACCESS_KEY=${R2_SECRET_ACCESS_KEY:?}
      - R2_BUCKET=${R2_BUCKET:?}
      - R2_ENDPOINT=${R2_ENDPOINT:?}
{% for key, value in env.items() if key not in ['LOG_LEVEL', 'TZ', 'WORKER_ID', 'JOB_TYPES', 'POLL_INTERVAL', 'MAX_CONCURRENT_JOBS', 'MAX_PROCESSING_TIME'] %}
      - {{ key | compose_env(value) }}
{% endfor %}

    deploy:
      resources:
        limits:
          memory: {{ resources.memory }}
          cpus: '{{ resources.cpu }}'

    healthcheck:
      # fabrik.scaffold.FILE_WORKER_HEARTBEAT_CHECK: the heartbeat was written in the last 120 s. No `$` (compose interpolates it here).
      test: ["CMD", "python", "-c", "import os,sys,time; p='/app/.tmp/worker_heartbeat'; sys.exit(0 if os.path.exists(p) and 0 <= time.time() - os.path.getmtime(p) < 120 else 1)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

    networks:
      - fabrik

{% for c in companion_services %}
{% include '_partials/_companion_service.yaml.j2' %}

{% endfor %}
networks:
  fabrik:
    external: true
