# Step 1: Build Static Site
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# Step 2: Runtime Environment
FROM node:22-bookworm-slim
WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE ${PORT}

# Mandatory Healthcheck for Final Gate
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:${PORT}/ || exit 1

COPY --from=builder /app/build ./build
COPY --from=builder /app/package.json ./
# B44: ``docusaurus serve`` needs the config file at runtime to know what
# to serve and the sidebar to render. Without these the container exits 1
# with "No config file found in site dir" and Coolify reports
# exited:unhealthy. Surfaced by proof-run on 2026-04-28.
COPY --from=builder /app/docusaurus.config.js ./
COPY --from=builder /app/sidebars.js ./
RUN npm install --omit=dev

# Create non-root user
RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app
USER appuser

CMD ["npm", "run", "serve", "--", "--host", "0.0.0.0", "--port", "3000"]
