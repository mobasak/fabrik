{% raw %}// The site root redirects to the first doc page. It also makes `build/index.html` exist, so `/`
// answers 200 under nginx's lookup `try_files $uri $uri.html $uri/index.html =404;` instead of the 404 page.
import React from 'react';
import {Redirect} from '@docusaurus/router';

export default function Home() {
  return <Redirect to="/docs/intro" />;
}
{% endraw %}
