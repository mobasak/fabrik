# Expo public env vars (inlined into the JS bundle at build time — never put
# secrets here; only values safe to ship in the client).

# Backend API base URL. A mobile device/emulator/simulator can't reach
# `localhost`/Docker DNS the way a browser on the host machine can — pick the
# value for your run target:
#   physical device   -> host machine's LAN IP, e.g. http://192.168.1.50:8000
#   Android emulator   -> http://10.0.2.2:8000
#   iOS simulator       -> http://localhost:8000
#   production           -> the deployed backend domain, e.g. https://api.your-vps.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

EXPO_PUBLIC_API_BASE_URL=https://api.your-vps.com/api/files
# The client talks ONLY to the backend API (Pattern A: the FastAPI backend is the
# IdP + owns Postgres). No DB/auth creds ship in the bundle — auth is via the
# backend's /auth endpoints, tokens stored with expo-secure-store.

# Sentry (crash reporting). Leave empty to disable in dev.
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat (in-app purchases / entitlements). See 81-mobile-billing.md.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# ─── Backend server (FastAPI) ─────────────────────────────────────────────────
# Read by server/src/app — these are SERVER-side (NOT shipped in the JS bundle).
# GET /app-config force-update contract (empty version = not enforced). A single
# version applies to both platforms; for per-platform gating see the note in
# server/src/app/routes/app_config.py (mobile_config.AppConfig supports a map).
APP_MIN_VERSION=
APP_LATEST_VERSION=
STORE_URL_ANDROID=
STORE_URL_IOS=
APP_KILL_SWITCH=false
APP_KILL_SWITCH_MESSAGE=
APP_PAYWALL_ID=
# JSON object of feature toggles; malformed input fails open to {} (never 500s).
APP_FEATURE_FLAGS={}
# Comma-separated CORS origins; empty = none (a native RN client doesn't need CORS).
CORS_ALLOW_ORIGINS=
