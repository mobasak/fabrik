services:
  {{ spec.id }}:
    build:
      context: .
      dockerfile: Dockerfile
    platform: linux/amd64  # Mandatory for x86_64 VPS
    container_name: {{ spec.id }}
    restart: unless-stopped

    environment:
      # Core
      - {{ 'NODE_ENV' | compose_env(env.get('NODE_ENV', 'production')) }}
      - {{ 'PORT' | compose_env(env.get('PORT', '3000')) }}
      - {{ 'LOG_LEVEL' | compose_env(env.get('LOG_LEVEL', 'info')) }}
      - {{ 'TZ' | compose_env(env.get('TZ', 'UTC')) }}

      # Supabase
      - SUPABASE_URL=${SUPABASE_URL:?}
      - SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY:?}
      - SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY:?}

      # R2 Storage
      - R2_ACCOUNT_ID=${R2_ACCOUNT_ID:?}
      - R2_ACCESS_KEY_ID=${R2_ACCESS_KEY_ID:?}
      - R2_SECRET_ACCESS_KEY=${R2_SECRET_ACCESS_KEY:?}
      - R2_BUCKET=${R2_BUCKET:?}
      - R2_ENDPOINT=${R2_ENDPOINT:?}

      # Upload config
      - {{ 'MAX_FILE_SIZE_MB' | compose_env(env.get('MAX_FILE_SIZE_MB', '100')) }}
      - {{ 'ALLOWED_CONTENT_TYPES' | compose_env(env.get('ALLOWED_CONTENT_TYPES', 'application/pdf,audio/mpeg,audio/wav')) }}
      - {{ 'UPLOAD_URL_EXPIRY_SECONDS' | compose_env(env.get('UPLOAD_URL_EXPIRY_SECONDS', '3600')) }}
      - {{ 'DOWNLOAD_URL_EXPIRY_SECONDS' | compose_env(env.get('DOWNLOAD_URL_EXPIRY_SECONDS', '3600')) }}
{% for key, value in env.items() if key not in ['NODE_ENV', 'PORT', 'LOG_LEVEL', 'TZ', 'MAX_FILE_SIZE_MB', 'ALLOWED_CONTENT_TYPES', 'UPLOAD_URL_EXPIRY_SECONDS', 'DOWNLOAD_URL_EXPIRY_SECONDS'] %}
      - {{ key | compose_env(value) }}
{% endfor %}

    deploy:
      resources:
        limits:
          memory: {{ resources.memory }}
          cpus: '{{ resources.cpu }}'

{% if health %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ env.get('PORT', '3000') }}{{ health.path }}"]
      interval: {{ health.interval | default('10s') }}
      timeout: {{ health.timeout | default('5s') }}
      retries: {{ health.retries | default(3) }}
      start_period: {{ health.start_period or '10s' }}
{% endif %}

{% if spec.domain %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ spec.id }}.rule=Host(`{{ spec.domain }}`)"
      - "traefik.http.routers.{{ spec.id }}.entrypoints=websecure"
      - "traefik.http.routers.{{ spec.id }}.tls=true"
      - "traefik.http.routers.{{ spec.id }}.tls.certresolver=letsencrypt"
      - "traefik.http.services.{{ spec.id }}.loadbalancer.server.port={{ env.get('PORT', '3000') }}"
{% endif %}

    networks:
      - fabrik

networks:
  fabrik:
    external: true
