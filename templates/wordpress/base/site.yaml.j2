# site.yaml — WordPress site spec (source of truth)
# Generated by: fabrik scaffold
# Edit before deploying.
#
# Merge order: defaults.yaml → presets/<preset>.yaml → this file
# Only include fields that override the preset. Pages, menus, plugins,
# theme, and seo are inherited from the preset and defaults layers.

schema_version: 1
preset: {{ preset | default('saas') }}

# ─────────────────────────────────────────────────────────────────────────────
# SITE IDENTITY (required)
# ─────────────────────────────────────────────────────────────────────────────

site:
  domain: {{ name }}.vps1.ocoron.com
  name: {{ name }}

# ─────────────────────────────────────────────────────────────────────────────
# BRAND (required)
# ─────────────────────────────────────────────────────────────────────────────

brand:
  name: "{{ name }}"
  tagline:
    en_US: "CHANGE_ME — Your tagline here"
  colors:
    primary: "#1e3a5f"

# ─────────────────────────────────────────────────────────────────────────────
# LANGUAGES (required: primary)
# ─────────────────────────────────────────────────────────────────────────────

languages:
  primary: en_US
  additional:
    - tr_TR

# ─────────────────────────────────────────────────────────────────────────────
# CONTACT (required: email)
# ─────────────────────────────────────────────────────────────────────────────

contact:
  email: admin@{{ name }}.vps1.ocoron.com

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT (required: target)
# ─────────────────────────────────────────────────────────────────────────────

deployment:
  target: production
