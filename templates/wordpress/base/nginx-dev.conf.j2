upstream php {
    server wordpress:9000;
}

server {
    listen 80;
    server_name _;

    root /var/www/html;
    index index.php index.html;

    # Security: HTTP headers (matches production hardening)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Security: Block PHP execution in uploads directory
    location ~* /(?:uploads|files)/.*\.php$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Security: Block sensitive backup/config/log file types
    location ~* \.(?:bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Security: Block xmlrpc.php (matches production hardening)
    location = /xmlrpc.php {
        return 444;
    }

    # PHP handling via FastCGI to WordPress FPM
    # NOTE: The existence check before fastcgi_pass is intentionally omitted in
    # dev; with bind-mounted wp-content volumes it can misfire and return 404
    # before WP's own rewrite logic runs. Production nginx (see
    # base/nginx/default.conf.j2) keeps the stricter directive since prod serves
    # from baked image paths.
    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass php;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    # WordPress permalinks
    location / {
        try_files $uri $uri/ /index.php?$args;
    }
}
