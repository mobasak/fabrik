# Makefile — {{ name }} WordPress operations
# Generated by Fabrik scaffold — 62-wordpress.md §WP-CLI & Makefile
# Usage: make <target>
# Requires: Docker running, container {{ name }}-wordpress up

# Resolve the running container name dynamically (Coolify may use a generated suffix)
WP_CONTAINER = $(shell docker ps --filter name={{ name }}-wordpress --format '{{{{.Names}}}}' | head -1)
WP = docker exec $(WP_CONTAINER) wp --path=/var/www/html --allow-root

.PHONY: update cache-flush scaffold backup harden security-check rename-admin warm-cache db-clean shell logs

## update — Update WordPress core, all plugins, and all themes
update:
	$(WP) core update
	$(WP) plugin update --all
	$(WP) theme update --all
	$(WP) core update-db
	@echo "Update complete."

## cache-flush — Flush WordPress object cache and rewrite rules
cache-flush:
	$(WP) cache flush
	$(WP) rewrite flush --hard
	@echo "Cache flushed."

## scaffold — Post-install setup: permalinks, Redis Object Cache, cleanup
scaffold:
	$(WP) rewrite structure '/%postname%/' --hard
	$(WP) plugin install redis-cache --activate
	$(WP) redis enable
	$(WP) post delete 1 --force 2>/dev/null || true
	$(WP) post delete 2 --force 2>/dev/null || true
	$(WP) plugin delete hello akismet 2>/dev/null || true
	$(WP) option update default_comment_status closed
	$(WP) option update close_comments_for_old_posts 1
	$(WP) option update close_comments_days_old 14
	$(WP) option update comment_moderation 1
	$(WP) widget delete $$($(WP) widget list sidebar-1 --format=ids 2>/dev/null) 2>/dev/null || true
	$(WP) theme delete $$($(WP) theme list --status=inactive --field=name 2>/dev/null) 2>/dev/null || true
	@echo "Scaffold complete."

## backup — Trigger server-level backup (daily)
backup:
	docker exec $(shell docker ps --filter name={{ name }}-backup --format '{{{{.Names}}}}' | head -1) /scripts/backup.sh daily
	@echo "Backup triggered."

## harden — Post-deploy hardening: Wordfence install, admin rename check, xmlrpc verify
harden:
	$(WP) plugin install wordfence --activate
	@echo "Checking admin username is not 'admin'..."
	@$(WP) user list --login=admin --field=user_login 2>/dev/null | grep -q admin && \
		echo "WARNING: user 'admin' exists — rename it immediately:" && \
		echo "  make rename-admin NEW_USER=<username>" || \
		echo "OK: no user named 'admin' found."
	@echo "Verifying xmlrpc.php is blocked..."
	@curl -s -o /dev/null -w "%{http_code}" https://{{ domain }}/xmlrpc.php | grep -qE '^(403|404|000)' && \
		echo "OK: xmlrpc.php blocked." || \
		echo "WARNING: xmlrpc.php returned unexpected status — check Nginx/Traefik config."
	@echo "Harden complete."
	@echo "Manual steps required in WP admin:"
	@echo "  1. Wordfence > Firewall > set to Extended Protection"
	@echo "  2. Wordfence > Login Security > enable 2FA for all admin/editor roles"
	@echo "  3. Wordfence > Brute Force > lock after 5 failed attempts, block 'admin' login attempts"

## security-check — Verify xmlrpc blocked, Wordfence active, admin user not 'admin', REST users blocked, table prefix set
security-check:
	@echo "=== Security Check: {{ name }} ==="
	@echo -n "xmlrpc.php blocked:         "
	@curl -s -o /dev/null -w "%{http_code}" https://{{ domain }}/xmlrpc.php | grep -qE '^(403|404|000)' && \
		echo "PASS" || echo "FAIL — xmlrpc.php is reachable"
	@echo -n "Wordfence active:            "
	@$(WP) plugin list --field=status --name=wordfence 2>/dev/null | grep -q active && \
		echo "PASS" || echo "FAIL — Wordfence not active"
	@echo -n "Admin user 'admin' absent:   "
	@$(WP) user list --login=admin --field=user_login 2>/dev/null | grep -q admin && \
		echo "FAIL — rename the admin user immediately" || echo "PASS (no admin user)"
	@echo -n "REST users endpoint blocked: "
	@curl -s -o /dev/null -w "%{http_code}" https://{{ domain }}/wp-json/wp/v2/users | grep -q 403 && \
		echo "PASS" || echo "FAIL — /wp-json/wp/v2/users not returning 403"
	@echo -n "Table prefix not wp_:        "
	@$(WP) db prefix 2>/dev/null | grep -qv '^wp_$$' && \
		echo "PASS" || echo "FAIL — table prefix is still wp_ (SQL injection risk)"
	@echo "=== End Security Check ==="

## db-clean — Prune database: expired transients, spam comments, orphaned postmeta, optimize tables
db-clean:
	$(WP) transient delete --expired
	$(WP) comment delete $(shell $(WP) comment list --status=spam --format=ids 2>/dev/null) --force 2>/dev/null || true
	$(WP) post delete $(shell $(WP) post list --post_type=revision --format=ids 2>/dev/null) --force 2>/dev/null || true
	@DB_PREFIX=$$($(WP) db prefix 2>/dev/null) && \
		$(WP) db query "DELETE pm FROM $${DB_PREFIX}postmeta pm LEFT JOIN $${DB_PREFIX}posts wp ON wp.ID = pm.post_id WHERE wp.ID IS NULL;"
	$(WP) db optimize
	@echo "Database cleaned and optimized."

## warm-cache — Purge Cloudflare cache then pre-prime Nginx FastCGI cache before DNS flip
# Note: Cloudflare zone cache purge (DELETE /client/v4/zones/{id}/purge_cache) must be
# triggered via fabrik CLI or Cloudflare API before running this target on content updates.
# This target only warms the origin FastCGI cache.
warm-cache:
	@echo "Warming cache for {{ domain }}..."
	@curl -s https://{{ domain }}/sitemap.xml | grep -oP '(?<=<loc>)[^<]+' | \
		xargs -P 8 -I {} sh -c 'curl -s -o /dev/null -w "%{http_code} {}\n" "{}"'
	@echo "Cache warming complete."

## rename-admin — Rename the admin user (usage: make rename-admin NEW_USER=siteowner)
rename-admin:
	@test -n "$(NEW_USER)" || (echo "Usage: make rename-admin NEW_USER=<username>" && exit 1)
	$(WP) user update admin --user_login=$(NEW_USER)
	@echo "Admin renamed to $(NEW_USER)."

## shell — Open a shell inside the WordPress container
shell:
	docker exec -it $(WP_CONTAINER) bash

## logs — Tail WordPress container logs
logs:
	docker logs -f $(WP_CONTAINER)
