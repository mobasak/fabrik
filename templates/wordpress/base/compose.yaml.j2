services:
  wordpress:
    image: wordpress:{{ php_version | default('php8.3') }}-fpm-bookworm
    platform: linux/amd64
    container_name: {{ name }}-wordpress
    restart: unless-stopped
    env_file:
      - .env
    environment:
      WORDPRESS_DB_HOST: {{ name }}-db
      WORDPRESS_DB_USER: ${DB_USER}
      WORDPRESS_DB_PASSWORD: ${DB_PASSWORD}
      WORDPRESS_DB_NAME: ${DB_NAME}
      WORDPRESS_CONFIG_EXTRA: |
        {{ wp_config_extra | indent(8) }}
    volumes:
      - wp_content:/var/www/html/wp-content
    networks:
      - {{ name }}-internal
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy

  nginx:
    image: nginx:mainline-bookworm-slim
    platform: linux/amd64
    container_name: {{ name }}-nginx
    restart: unless-stopped
    volumes:
      - wp_content:/var/www/html/wp-content:ro
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - coolify
      - {{ name }}-internal
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ name }}.rule=Host(`{{ domain }}`)"
      - "traefik.http.routers.{{ name }}.entrypoints=websecure"
      - "traefik.http.routers.{{ name }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{ name }}.middlewares={{ name }}-rate-limit"
      - "traefik.http.services.{{ name }}.loadbalancer.server.port=80"
      # Security: Block xmlrpc.php (brute-force attack vector)
      - "traefik.http.routers.{{ name }}-xmlrpc.rule=Host(`{{ domain }}`) && Path(`/xmlrpc.php`)"
      - "traefik.http.routers.{{ name }}-xmlrpc.entrypoints=websecure"
      - "traefik.http.routers.{{ name }}-xmlrpc.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{ name }}-xmlrpc.priority=100"
      - "traefik.http.routers.{{ name }}-xmlrpc.middlewares={{ name }}-block-xmlrpc"
      - "traefik.http.middlewares.{{ name }}-block-xmlrpc.replacepathregex.regex=.*"
      - "traefik.http.middlewares.{{ name }}-block-xmlrpc.replacepathregex.replacement=/wp-login.php?blocked=xmlrpc"
      # Security: Rate-limit all requests (10 req/s avg, burst 20)
      - "traefik.http.middlewares.{{ name }}-rate-limit.ratelimit.average=10"
      - "traefik.http.middlewares.{{ name }}-rate-limit.ratelimit.burst=20"
    depends_on:
      - wordpress

  db:
    image: mariadb:10.11
    platform: linux/amd64
    container_name: {{ name }}-db
    restart: unless-stopped
    env_file:
      - .env
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD}
      MYSQL_DATABASE: ${DB_NAME}
      MYSQL_USER: ${DB_USER}
      MYSQL_PASSWORD: ${DB_PASSWORD}
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - {{ name }}-internal
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-bookworm
    platform: linux/amd64
    container_name: {{ name }}-redis
    restart: unless-stopped
    volumes:
      - redis_data:/data
    networks:
      - {{ name }}-internal
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  backup:
    image: debian:bookworm-slim
    platform: linux/amd64
    container_name: {{ name }}-backup
    restart: unless-stopped
    env_file:
      - .env
    environment:
      DB_HOST: {{ name }}-db
      DB_NAME: ${DB_NAME}
      DB_USER: ${DB_USER}
      DB_PASSWORD: ${DB_PASSWORD}
      R2_ENDPOINT: ${R2_ENDPOINT}
      R2_ACCESS_KEY: ${R2_ACCESS_KEY}
      R2_SECRET_KEY: ${R2_SECRET_KEY}
      R2_BUCKET: ${R2_BUCKET}
      SITE_NAME: {{ name }}
    volumes:
      - ./backup:/scripts:ro
      - wp_content:/wordpress/wp-content:ro
      - backup_data:/backups
    networks:
      - {{ name }}-internal
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        apt-get update && apt-get install -y --no-install-recommends mariadb-client awscli gzip && rm -rf /var/lib/apt/lists/*
        echo "0 3 * * * /scripts/backup.sh daily" >> /etc/crontabs/root
        echo "0 4 * * 0 /scripts/backup.sh weekly" >> /etc/crontabs/root
        crond -f -l 2
    depends_on:
      db:
        condition: service_healthy

volumes:
  wp_content:
  db_data:
  redis_data:
  backup_data:

networks:
  coolify:
    external: true
  {{ name }}-internal:
    driver: bridge
