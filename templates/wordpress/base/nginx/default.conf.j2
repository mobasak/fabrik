fastcgi_cache_path /tmp/wp_cache levels=1:2 keys_zone=wp_cache:10m inactive=60m max_size=256m;
fastcgi_cache_key "$scheme$request_method$host$request_uri";

upstream php {
    server wordpress:9000;
}

server {
    listen 80;
    server_name _;

    root /var/www/html;
    index index.php index.html;

    # Security: Block xmlrpc.php (brute-force attack vector)
    location = /xmlrpc.php {
        return 444;
    }

    # Security: Deny access to sensitive files
    location ~ /\.(ht|git|env) {
        deny all;
    }

    # Static files: long cache, served directly by nginx
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # PHP handling via FastCGI to WordPress FPM
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass php;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        # FastCGI cache
        fastcgi_cache wp_cache;
        fastcgi_cache_valid 200 60m;
        fastcgi_cache_bypass $http_cookie;
        fastcgi_no_cache $http_cookie;
        add_header X-FastCGI-Cache $upstream_cache_status;
    }

    # WordPress permalinks
    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 4;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;
}
