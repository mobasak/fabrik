services:
  wordpress:
    image: wordpress:{{ php_version | default('php8.3') }}-fpm
    platform: linux/amd64
    restart: unless-stopped
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: wp_user
      WORDPRESS_DB_PASSWORD: "{{ db_password }}"
      WORDPRESS_DB_NAME: wordpress
      WORDPRESS_TABLE_PREFIX: "{{ table_prefix | default(name | replace('-', '_') + '_prod_') }}"
      # Note: extended wp-config options (debug, cache, redis, memory) are applied
      # post-install by the settings pipeline stage via WP-CLI to stay within
      # Coolify's varchar(255) env var limit.
    volumes:
      - wp_html:/var/www/html
      - {{ site_dir }}/php-fpm/zz-fabrik-listen.conf:/usr/local/etc/php-fpm.d/zz-fabrik-listen.conf:ro
    command:
      - /bin/sh
      - -c
      - |
        # Install WP-CLI (php8.3-fpm image doesn't include it, unlike apache)
        curl -fsSL -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
        chmod +x /usr/local/bin/wp
        # Start PHP-FPM
        php-fpm
    networks:
      - {{ name }}-internal
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy

  nginx:
    image: nginx:mainline-alpine
    platform: linux/amd64
    restart: unless-stopped
    volumes:
      - wp_html:/var/www/html:ro
      - {{ site_dir }}/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - coolify
      - {{ name }}-internal
    labels:
      - traefik.enable=true
      - traefik.http.routers.{{ name }}.rule=Host(`{{ domain }}`)
      - traefik.http.routers.{{ name }}.entrypoints=websecure
      - traefik.http.routers.{{ name }}.tls=true
      - traefik.http.routers.{{ name }}.tls.certresolver=letsencrypt
      - traefik.http.services.{{ name }}.loadbalancer.server.port=80
      - traefik.http.routers.{{ name }}-www.rule=Host(`www.{{ domain }}`)
      - traefik.http.routers.{{ name }}-www.entrypoints=websecure
      - traefik.http.routers.{{ name }}-www.tls=true
      - traefik.http.routers.{{ name }}-www.middlewares={{ name }}-www-redirect
      - traefik.http.middlewares.{{ name }}-www-redirect.redirectregex.regex=^https://www\.{{ domain | replace('.', '\.') }}/(.*)
      - traefik.http.middlewares.{{ name }}-www-redirect.redirectregex.replacement=https://{{ domain }}/$${1}
      # Security: Rate-limit on main router (one middlewares label per router — 62-wordpress.md)
      - traefik.http.routers.{{ name }}.middlewares={{ name }}-rate-limit
      # Security: Block xmlrpc.php (brute-force attack vector)
      - traefik.http.routers.{{ name }}-xmlrpc.rule=Host(`{{ domain }}`) && Path(`/xmlrpc.php`)
      - traefik.http.routers.{{ name }}-xmlrpc.entrypoints=websecure
      - traefik.http.routers.{{ name }}-xmlrpc.tls=true
      - traefik.http.routers.{{ name }}-xmlrpc.tls.certresolver=letsencrypt
      - traefik.http.routers.{{ name }}-xmlrpc.priority=100
      - traefik.http.routers.{{ name }}-xmlrpc.middlewares={{ name }}-block-xmlrpc
      - traefik.http.middlewares.{{ name }}-block-xmlrpc.replacepathregex.regex=.*
      - traefik.http.middlewares.{{ name }}-block-xmlrpc.replacepathregex.replacement=/wp-login.php?blocked=xmlrpc
      # Security: Rate-limit wp-login.php (10 req/min per IP, burst 20) — 62-wordpress.md
      - traefik.http.middlewares.{{ name }}-rate-limit.ratelimit.average=10
      - traefik.http.middlewares.{{ name }}-rate-limit.ratelimit.burst=20
      - traefik.http.middlewares.{{ name }}-rate-limit.ratelimit.period=1m
    depends_on:
      - wordpress

  db:
    image: mariadb:10.11
    platform: linux/amd64
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "{{ db_root_password }}"
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wp_user
      MYSQL_PASSWORD: "{{ db_password }}"
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - {{ name }}-internal
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-bookworm
    platform: linux/amd64
    restart: unless-stopped
    volumes:
      - redis_data:/data
    networks:
      - {{ name }}-internal
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  backup:
    image: debian:bookworm-slim
    platform: linux/amd64
    restart: unless-stopped
    environment:
      DB_HOST: db
      DB_NAME: wordpress
      DB_USER: wp_user
      DB_PASSWORD: "{{ db_password }}"
      R2_ENDPOINT: "{{ r2_endpoint }}"
      R2_ACCESS_KEY: "{{ r2_access_key }}"
      R2_SECRET_KEY: "{{ r2_secret_key }}"
      R2_BUCKET: "{{ r2_bucket }}"
      SITE_NAME: "{{ name }}"
    volumes:
      - {{ site_dir }}/backup:/scripts:ro
      - wp_html:/var/www/html/wp-content:ro
      - backup_data:/backups
    networks:
      - {{ name }}-internal
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        apt-get update && apt-get install -y --no-install-recommends mariadb-client awscli gzip cron && rm -rf /var/lib/apt/lists/*
        echo "0 3 * * * root /scripts/backup.sh daily" >> /etc/cron.d/backup
        echo "0 4 * * 0 root /scripts/backup.sh weekly" >> /etc/cron.d/backup
        chmod 0644 /etc/cron.d/backup
        cron -f
    depends_on:
      db:
        condition: service_healthy

volumes:
  wp_html:
  db_data:
  redis_data:
  backup_data:

networks:
  coolify:
    external: true
  {{ name }}-internal:
    driver: bridge
