# Makefile.python - Standard commands for Python projects
# Copy to project root as "Makefile" and customize:
#   1. PROJECT_NAME
#   2. PORT
#   3. Entry point in dev command
#
# Usage: make setup-dev, make dev, make test, make docker-smoke

.PHONY: setup-dev dev test docker-smoke docker-build docker-dev clean install lint format gate-lean

# ===== CUSTOMIZE THESE =====
PROJECT_NAME ?= myproject
PORT ?= 8000
# ===========================

# ============================================================
# Environment Setup
# ============================================================

setup-dev:
	python -m venv .venv
	.venv/bin/pip install -r requirements-dev.txt

# ============================================================
# Local Development (fast)
# ============================================================

install:
	uv sync

dev:
	PYTHONPATH=src uvicorn <package_name>.main:app --host 0.0.0.0 --port $(PORT) --reload

# test, lint and format run the project's own tools from .venv (what `make setup-dev` installs),
# never a PATH tool that cannot import the project's dependencies. A missing tool says what to run.
# These three paths are files, never .PHONY: listed there, the rule would fire with the venv filled.
.venv/bin/pytest .venv/bin/ruff .venv/bin/mypy:
	@echo "$@ is missing: run 'make setup-dev' first" >&2; exit 1

test: .venv/bin/pytest
	.venv/bin/pytest -v

lint: .venv/bin/ruff .venv/bin/mypy
	.venv/bin/ruff check .
	.venv/bin/mypy src

format: .venv/bin/ruff
	.venv/bin/ruff format .
	.venv/bin/ruff check --fix .

gate-lean:
	@.venv/bin/ruff check . --fix && .venv/bin/ruff format . && .venv/bin/mypy src

# ============================================================
# Docker (parity check)
# ============================================================

docker-build:
	docker build -t $(PROJECT_NAME) .

docker-smoke: docker-build
	@echo "Starting container..."
	@docker run -d --name smoke-test -p $(PORT):$(PORT) --env-file .env $(PROJECT_NAME) || true
	@sleep 3
	@echo "Health check..."
	@curl -sf http://localhost:$(PORT)/health && echo " ✓ Health OK" || echo " ✗ Health FAILED"
	@docker stop smoke-test && docker rm -v smoke-test

docker-dev:
	docker compose -f compose.yaml -f compose.dev.yaml up --build

# ============================================================
# Cleanup
# ============================================================

clean:
	docker stop smoke-test 2>/dev/null || true
	docker rm -v smoke-test 2>/dev/null || true
	docker rmi $(PROJECT_NAME) 2>/dev/null || true
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find . -type d -name .pytest_cache -exec rm -rf {} + 2>/dev/null || true
