# compose.yaml - Production-like Docker Compose
# Auto-generated by fabrik scaffold. Customize as needed:
#   1. Port number (default: 8000)
#   2. Environment variables (use ${VAR:?} for required vars)
#   3. Traefik labels (host rule auto-set to <domain>; edit for custom routing)
#
# Used by: Coolify deployment (git source), docker-smoke test
# No bind mounts, no dev tools - production parity
#
# Notes on Coolify v4 routing:
#   - The traefik.* labels below tell Traefik (managed by Coolify) how to
#     route HTTPS requests for <domain> to this service. Without them, the
#     deployed app is unreachable at its spec domain even when the
#     container is healthy. (See B16 in CHANGELOG, 2026-04-27.)
#   - The "coolify" external network is provided by Coolify and is how
#     Traefik discovers containers.

services:
  <project>:
    build:
      context: .
      dockerfile: Dockerfile
    platform: linux/amd64
    container_name: <project>
    environment:
      # Required (have defaults)
      - PORT=${PORT:-8000}
      - LOG_LEVEL=${LOG_LEVEL:-INFO}
      # Optional (uncomment if using database)
      # - DATABASE_URL=${DATABASE_URL}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:${PORT:-8000}/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    restart: unless-stopped
    # F5: Coolify v4 build_pack=dockercompose does not honour the limits_memory
    # UI field. Declaring the limit here makes Docker enforce it on every
    # redeploy. Tune per-project as needed.
    deploy:
      resources:
        limits:
          memory: 512M
          cpus: '0.5'
    networks:
      - coolify
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=coolify"
      - "traefik.http.routers.<project>.rule=Host(`<domain>`)"
      - "traefik.http.routers.<project>.entrypoints=websecure"
      - "traefik.http.routers.<project>.tls=true"
      - "traefik.http.routers.<project>.tls.certresolver=letsencrypt"
      # B18: Hardcoded port — Coolify's compose parser does not always
      # interpolate ${PORT:-8000} inside Traefik label strings, leaving
      # the literal text as the port and producing 404 from Traefik.
      # If the app listens on a different port, edit both the healthcheck
      # above and this label.
      - "traefik.http.services.<project>.loadbalancer.server.port=8000"

networks:
  coolify:
    external: true

# Uncomment for services that need persistent storage
