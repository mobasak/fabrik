SITE ?= $(shell basename $(CURDIR))

.PHONY: update cache-flush scaffold backup harden security-check logs shell

update:
	ssh vps "sudo docker exec $(SITE)-wordpress-1 wp core update --allow-root && \
		sudo docker exec $(SITE)-wordpress-1 wp plugin update --all --allow-root && \
		sudo docker exec $(SITE)-wordpress-1 wp theme update --all --allow-root"

cache-flush:
	ssh vps "sudo docker exec $(SITE)-wordpress-1 wp cache flush --allow-root && \
		sudo docker exec $(SITE)-wordpress-1 wp rewrite flush --allow-root"

scaffold:
	fabrik wp plan $(SITE)
	fabrik wp apply $(SITE) --dry-run

backup:
	ssh vps "sudo docker exec $(SITE)-wordpress-1 wp db export /var/www/html/wp-content/$(SITE)-db-$$(date +%Y%m%d-%H%M%S).sql --allow-root"

harden:
	ssh vps "sudo docker exec $(SITE)-wordpress-1 wp option update blog_public 1 --allow-root && \
		sudo docker exec $(SITE)-wordpress-1 wp option update default_pingback_flag 0 --allow-root && \
		sudo docker exec $(SITE)-wordpress-1 wp option update default_ping_status closed --allow-root && \
		sudo docker exec $(SITE)-wordpress-1 wp option update default_comment_status closed --allow-root"

security-check:
	ssh vps "sudo docker exec $(SITE)-wordpress-1 wp option get table_prefix --allow-root && \
		sudo docker exec $(SITE)-wordpress-1 wp user list --allow-root --format=table && \
		sudo docker exec $(SITE)-wordpress-1 wp plugin list --allow-root --format=table"

logs:
	ssh vps "sudo docker logs --tail=100 -f $(SITE)-wordpress-1"

shell:
	ssh vps "sudo docker exec -it $(SITE)-wordpress-1 bash"
