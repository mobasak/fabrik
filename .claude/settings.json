{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(python3 -m ruff:*)",
      "Bash(ruff:*)",
      "Bash(python -m mypy:*)",
      "Bash(python3 -m mypy:*)",
      "Bash(mypy:*)",
      "Bash(python scripts/final_gate.py:*)",
      "Bash(python3 scripts/final_gate.py:*)",
      "Bash(.venv/bin/python scripts/final_gate.py:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(alembic:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/final_gate_stop.py\" --baseline",
            "timeout": 120,
            "statusMessage": "Snapshotting gate baseline..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_orient.py\"",
            "timeout": 10,
            "statusMessage": "Orienting: governance + memory + session-recall..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent_role.py\"",
            "timeout": 10,
            "statusMessage": "Loading agent role charter..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/mail_notify.py\"",
            "timeout": 10,
            "statusMessage": "Checking fabrik-mail inbox..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/thread_anchor.py\" line --hook",
            "timeout": 10,
            "statusMessage": "Recalling open threads..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/final_gate_stop.py\"",
            "timeout": 120,
            "statusMessage": "Definition of done \u2014 verifying final_gate..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/skill_router.py\"",
            "timeout": 15,
            "statusMessage": "Routing to a /fabrik-* skill..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/mail_notify.py\"",
            "timeout": 10,
            "statusMessage": "Checking fabrik-mail inbox..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/thread_anchor.py\" line --hook",
            "timeout": 10,
            "statusMessage": "Recalling open threads..."
          }
        ]
      }
    ]
  }
}
