{
  "name": "Backup Status Notification",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "http://duplicati:8200/api/v1/status",
        "options": {}
      },
      "id": "get-backup-status",
      "name": "Check Backup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://apprise:8000/notify",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "urls",
              "value": "slack://tokenA/tokenB/tokenC"
            },
            {
              "name": "title",
              "value": "Backup Complete"
            },
            {
              "name": "body",
              "value": "Daily backup completed successfully"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-apprise",
      "name": "Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Check Backup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Backup": {
      "main": [
        [
          {
            "node": "Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
