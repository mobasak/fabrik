   "/opt/fabrik",
   "scripts/mail.py",
   "claude_rotate",
   "claude-reboot-sweep",
   "sync-claude-accounts",
   "dr_claude_backup",
   "$HOME/.claude/",
   "/home/ozgur/.claude/"
  ]
 },
