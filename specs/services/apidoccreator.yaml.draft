id: apidoccreator
kind: service
template: python-api
domain: apidoccreator.vps1.ocoron.com
shape:
  kind: service
  is_public: true
  is_admin_dashboard: false
  has_bearer_api: false
  has_persistent_data: false
  needs_database: true
  has_search_feature: false
  needs_cache: true
  exposes_metrics: false
expose:
  http: true
  internal_only: false
source:
  type: template
  branch: main
depends:
  postgres: main
  redis: main
infrastructure:
  database: local
  storage: local
  auth: none
env:
  DATABASE_URL: ${DATABASE_URL:?DATABASE_URL is required}
  PORT: ${PORT:-8302}
  LOG_LEVEL: ${LOG_LEVEL:-INFO}
  SERVICE_NAME: ${SERVICE_NAME:-docs-registry}
  KILO_API_URL: ${KILO_API_URL:-https://api.kilo.ai/api/openrouter/v1/chat/completions}
  LLM_DEFAULT_MODEL: ${LLM_DEFAULT_MODEL:-anthropic/claude-sonnet-4-5}
  SCRAPE_CONCURRENCY: ${SCRAPE_CONCURRENCY:-5}
  REFRESH_INTERVAL_DAYS: ${REFRESH_INTERVAL_DAYS:-7}
  FRONTEND_DIST_PATH: ${FRONTEND_DIST_PATH:-/app/frontend/dist}
  ALLOWED_ORIGINS: ${ALLOWED_ORIGINS:-*}
  REDIS_URL: ${REDIS_URL:-redis://localhost:6379/0}
  CRAWL4AI_URL: ${CRAWL4AI_URL:-http://crawl4ai:11235}
  BROWSERLESS_URL: ${BROWSERLESS_URL:-}
secrets:
  required: []
  generate: []
  from_env:
  - KILO_API_KEY
  - API_SECRET_KEY
  - SERVICE_INTERNAL_SECRET_KEY
  - EXA_API_KEY
  from_file: {}
resources:
  memory: 512M
  cpu: '0.5'
health:
  path: /health
  interval: 30s
  timeout: 10s
  retries: 3
  disabled: false
volumes: []
companion_services: []
backup:
  enabled: true
  frequency: daily
  retention: 30
watchdog:
  enabled: false
  daily_budget_usd: 1.0
  daily_invocations_cap: 200
  auto_tier_b: false
  escalation_channel: apprise
  llm_provider_primary: claude-code
  llm_provider_fallback: openrouter
  cheap_model: haiku
  expensive_model: sonnet
  per_incident_budget_usd: 0.5
  deadman_timeout_seconds: 300
  external_docs_enabled: true
  propose_fix_prs: false
  auto_code_fix: false
  code_fix_window_sec: 1800
  critical_paths: []
  trigger_sources: []
