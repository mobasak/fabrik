id: brand-identiy-creator
kind: service
template: python-api
domain: brand-identiy-creator.vps1.ocoron.com
shape:
  kind: service
  is_public: true
  is_admin_dashboard: false
  has_bearer_api: false
  has_persistent_data: false
  needs_database: true
  has_search_feature: false
  needs_cache: true
  exposes_metrics: true
expose:
  http: true
  internal_only: false
source:
  type: git
  repository: https://github.com/mobasak/brand-identity-creator.git
  branch: master
depends:
  postgres: main
  redis: main
infrastructure:
  database: local
  storage: local
  auth: none
env:
  SERVICE_NAME: brand-identity
  ENVIRONMENT: ${ENVIRONMENT:-production}
  DATABASE_URL: ${DATABASE_URL}
  REDIS_URL: ${REDIS_URL:-redis://redis-main:6379/1}
  JWT_ALGORITHM: ${JWT_ALGORITHM:-HS256}
  JWT_EXPIRE_MINUTES: ${JWT_EXPIRE_MINUTES:-15}
  JWT_REFRESH_DAYS: ${JWT_REFRESH_DAYS:-7}
  OPENROUTER_READ_TIMEOUT: ${OPENROUTER_READ_TIMEOUT:-120}
  REPLICATE_READ_TIMEOUT: ${REPLICATE_READ_TIMEOUT:-120}
  MAX_DAILY_GPU_COST: ${MAX_DAILY_GPU_COST:-5.00}
  CORS_ORIGINS: ${CORS_ORIGINS}
  GLITCHTIP_DSN: ${GLITCHTIP_DSN:-}
  OUTPUT_BASE_PATH: ${OUTPUT_BASE_PATH:-/data/output}
secrets:
  required: []
  generate: []
  from_env:
  - JWT_SECRET_KEY
  - ANTHROPIC_API_KEY
  - OPENROUTER_API_KEY
  - REPLICATE_API_TOKEN
  - BFL_API_KEY
  - PORKBUN_API_KEY
  - PORKBUN_SECRET_KEY
  - RESEND_API_KEY
  - EXA_API_KEY
  - FIRECRAWL_API_KEY
  - SERVICE_INTERNAL_SECRET_KEY
  from_file: {}
resources:
  memory: 512M
  cpu: '0.5'
health:
  path: /health
  interval: 30s
  timeout: 10s
  retries: 3
  disabled: false
volumes: []
companion_services: []
backup:
  enabled: true
  frequency: daily
  retention: 30
watchdog:
  enabled: false
  daily_budget_usd: 1.0
  daily_invocations_cap: 200
  auto_tier_b: false
  escalation_channel: apprise
  llm_provider_primary: claude-code
  llm_provider_fallback: openrouter
  cheap_model: haiku
  expensive_model: sonnet
  per_incident_budget_usd: 0.5
  deadman_timeout_seconds: 300
  external_docs_enabled: true
  propose_fix_prs: false
  auto_code_fix: false
  code_fix_window_sec: 1800
  critical_paths: []
  trigger_sources: []
