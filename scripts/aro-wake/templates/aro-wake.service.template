[Unit]
Description=aro-wake — push-trigger entry point for the {{HOST_NAME}} sysadmin AI
After=network.target wg-quick@wg0.service
Wants=network-online.target
# StartLimit* are [Unit] keys, NOT [Service]. They sat in [Service] from the
# original template, where systemd IGNORES them — measured live on vps1
# 2026-08-31: "/etc/systemd/system/aro-wake.service:27: Unknown key name
# 'StartLimitIntervalSec' in section 'Service', ignoring." So with Restart=always
# and no working rate limit, a crash-looping aro-wake would have restarted
# forever, unthrottled, instead of stopping after 5 tries in 300s. The sibling
# vps-sysadmin-bot.service.template already places them correctly — this was the
# lone outlier, and systemd confirmed it is the only ignored key on the box.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ozgur
WorkingDirectory=/opt/fabrik/scripts/aro-wake
# Bind 0.0.0.0 so the receiver is reachable from BOTH:
#   - the wg0 mesh IP (peers calling /wake for consult)
#   - docker containers on the fabrik network calling via the host's
#     routing table (Alertmanager webhook in Phase 4 calls
#     http://10.99.0.1:8201/wake from inside its container)
# Public-internet ingress to port 8201 is blocked by UFW (default deny
# on incoming + the allow-list does NOT include 8201). Verified 2026-06-05
# on vps1 hub: `ufw status verbose` shows only 22/80/443/1194/51820 allowed.
# DOCKER-USER iptables chain rules (loaded at boot) also explicitly block
# the 8200-8299 management-tools port range from public interfaces — see
# /etc/iptables/rules.v4 on each host.
ExecStart=/opt/fabrik/.venv-aro-wake/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 8201 \
    --no-access-log
Restart=always
RestartSec=10
# (StartLimitIntervalSec / StartLimitBurst live in [Unit] above — see the note there.)

# Host identity passed to main.py via env.
# ARO_WAKE_PEER_HOSTS uses CSV format (name:ip,name:ip) — NOT bare JSON.
# Verified 2026-06-04: systemd's bare Environment=KEY={"a":"b"} STRIPS the
# embedded double-quotes (so Python sees `{a:b}`, which json.loads rejects).
# CSV has no quoting hazard and parses cleanly in main.py::_parse_peer_hosts.
Environment=ARO_WAKE_HOST_NAME={{HOST_NAME}}
Environment=ARO_WAKE_HOST_ROLE={{HOST_ROLE}}
Environment=ARO_WAKE_HOST_IP={{HOST_IP}}
Environment=ARO_WAKE_PEER_HOSTS={{PEER_HOSTS_CSV}}
Environment=CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Phase 4 bind change (2026-06-05): switched from BIND_HOST mesh-IP-only
# to 0.0.0.0. Reason: Alertmanager runs in a docker container on the
# `fabrik` network and cannot reach the host's wg0 IP from inside its
# namespace (verified: curl from container → 10.99.0.1:8201 times out).
# Binding 0.0.0.0 keeps wg0-IP reachability for peer consults AND adds
# docker-bridge reachability for Alertmanager webhook delivery, with the
# public side blocked by UFW default-deny posture (see ExecStart comment).
# {{BIND_HOST}} placeholder is no longer consumed but kept in template
# rendering for backwards compatibility.

StandardOutput=append:/var/log/aro-wake.log
StandardError=append:/var/log/aro-wake.log

[Install]
WantedBy=multi-user.target
