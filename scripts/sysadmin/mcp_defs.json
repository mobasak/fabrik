{
  "mcpServers": {
    "brave-search": {
      "args": [
        "-y",
        "@brave/brave-search-mcp-server",
        "--transport",
        "stdio"
      ],
      "command": "npx",
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "type": "stdio"
    },
    "chrome-devtools": {
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    },
    "exa": {
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "command": "npx",
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "type": "stdio"
    },
    "fabrik-citation-verifier": {
      "type": "http",
      "url": "http://127.0.0.1:8033/mcp"
    },
    "firecrawl": {
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "command": "npx",
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "type": "stdio"
    },
    "grafana": {
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "mcp/grafana",
        "-t",
        "stdio"
      ],
      "command": "docker",
      "env": {
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}",
        "GRAFANA_URL": "${GRAFANA_URL}"
      },
      "type": "stdio"
    },
    "maestro": {
      "args": [
        "mcp"
      ],
      "command": "/home/ozgur/.maestro/bin/maestro",
      "env": {},
      "type": "stdio"
    },
    "magicui": {
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    },
    "media-engine": {
      "args": [
        "-m",
        "media_edit.mcp_server"
      ],
      "command": "/opt/iterative_image_editor/.venv/bin/python",
      "env": {
        "MCP_SESSION_BUDGET_USD": "500.0",
        "PYTHONPATH": "/opt/iterative_image_editor/src"
      },
      "type": "stdio"
    },
    "mobile-mcp": {
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@latest"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    },
    "postgres-pro": {
      "args": [
        "--with",
        "mcp<2",
        "postgres-mcp",
        "--access-mode=restricted"
      ],
      "command": "/home/ozgur/.local/bin/uvx",
      "type": "stdio"
    },
    "pubchem": {
      "args": [
        "-y",
        "@cyanheads/pubchem-mcp-server"
      ],
      "command": "npx",
      "env": {
        "PATH": "/home/ozgur/.nvm/versions/node/v24.16.0/bin:/usr/bin:/bin"
      },
      "type": "stdio"
    },
    "serena": {
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--enable-web-dashboard",
        "false"
      ],
      "command": "/home/ozgur/.local/bin/uvx",
      "env": {},
      "type": "stdio"
    },
    "session-recall": {
      "args": [
        "/opt/session-recall/server.py"
      ],
      "command": "/opt/session-recall/.venv/bin/python"
    },
    "shadcn": {
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    }
  }
}
