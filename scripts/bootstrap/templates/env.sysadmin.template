# /opt/fabrik/.env.sysadmin — per-host sysadmin AI credentials + routing.
# Generated by: scripts/bootstrap/bootstrap-vps.sh step_14_install_sysadmin_pack()
# Host: {{HOST_NAME}}
#
# Mode 600, owner ozgur:ozgur, gitignored. Mirrored to mobasak/fabrik-dr-store
# via the existing W9 inotify watcher (path: env/sysadmin/{{HOST_NAME}}).
# Per Lesson 75 + trio plan §2.7: this is a SECRET — never log, never commit.

# Telegram routing — fill in BEFORE enabling vps-sysadmin-bot.service.
# Option A (recommended): three @BotFather bots, one per host. Each host
# has its own conversation in the operator's Telegram. No prefix routing
# ambiguity. SysAdminVPS1 / SysAdminVPS2 / SysAdminVPS3 in chat list.
# Option B: one shared bot token across all 3 hosts; prefix-based routing
# via the bot's getUpdates filter on `@vps{{HOST_NAME}}` mentions.
TELEGRAM_BOT_TOKEN=__OPERATOR_TO_FILL__
TELEGRAM_OWNER_ID=__OPERATOR_TO_FILL__

# OpenRouter fallback — same key across all 3 hosts (one operator account).
# Used only when Claude Code primary path is unreachable (OAuth stale, rate
# limit, sandbox failure). Lesson 74 / 75. Trio plan §1.6 acknowledges
# all-fleet-fallback risk if OpenRouter 402s — operator monitors credit.
WATCHDOG_OPENROUTER_KEY=__OPERATOR_TO_FILL_OR_LEAVE_EMPTY_FOR_NO_FALLBACK__

# Host identity — already set as systemd Environment= by the unit file;
# duplicated here so cron-fired scripts (which don't inherit the unit's
# environment) can read them via `set -a; . /opt/fabrik/.env.sysadmin`.
SYSADMIN_HOST_NAME={{HOST_NAME}}
SYSADMIN_HOST_ROLE={{HOST_ROLE}}
SYSADMIN_HOST_IP={{HOST_IP}}
SYSADMIN_PEER_HOSTS={{PEER_HOSTS}}

# Health endpoint binding — 127.0.0.1 by default (loopback-only). Set to
# the mesh IP if you want peers to be able to probe it; never 0.0.0.0.
SYSADMIN_HEALTH_HOST=127.0.0.1
SYSADMIN_HEALTH_PORT=8017

# Claude model — leave as "opus" for veteran-class reasoning. Operator
# directive: no per-call $ caps on sysadmin (memory: feedback_no_budget_caps_sysadmin).
SYSADMIN_MODEL=opus
