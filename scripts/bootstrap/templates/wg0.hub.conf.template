# Wireguard hub configuration (vps1).
# Rendered by scripts/bootstrap/setup-wireguard-hub.sh.
# DO NOT edit this file directly on the VPS — rerun the bootstrap script
# to regenerate. Manual edits will be lost on next peer-add operation.
#
# Variables (envsubst):
#   {{HUB_PRIVATE_KEY}} — base64-encoded private key, generated by `wg genkey`
#   {{HUB_MESH_IP}}     — e.g. 10.99.0.1
#   {{WG_PORT}}         — UDP listen port, e.g. 51820
#   {{WG_MTU}}          — interface MTU, e.g. 1420
#
# Peer blocks are appended by scripts/bootstrap/add-mesh-peer.sh when a new
# VPS is bootstrapped. The marker "# === PEERS BELOW ===" is required and
# must not be removed.

[Interface]
PrivateKey = {{HUB_PRIVATE_KEY}}
Address = {{HUB_MESH_IP}}/24
ListenPort = {{WG_PORT}}
MTU = {{WG_MTU}}

# IP forwarding NOT enabled here on purpose — vps1 is a hub for terminating
# mesh connections, not a router. Each spoke peers directly with the hub
# and reads/writes services hosted on the hub via its WG IP. Spoke-to-spoke
# traffic is not routed through the hub (use AllowedIPs to restrict).
# If you ever need spoke-to-spoke routing, also enable:
#   sysctl -w net.ipv4.ip_forward=1
# and add iptables FORWARD rules.

# MSS clamping for outbound mesh traffic (handles cases where path MTU is
# lower than the configured WG MTU). PostUp/PostDown applied on interface
# bring-up/down by systemd unit wg-quick@wg0.
PostUp = iptables -t mangle -A FORWARD -o %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
PostDown = iptables -t mangle -D FORWARD -o %i -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

# === PEERS BELOW ===
# (peer blocks are appended here by add-mesh-peer.sh)
